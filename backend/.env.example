# BLE OBD Adaptör Ayarları
# Boş bırakılırsa isimle otomatik taranır (OBD, VLINK, VGATE vb.)
BLE_OBD_ADDRESS=
BLE_OBD_NAME_HINTS=OBD,OBDII,ELM,VLINK,VGATE,CAN
BLE_WRITE_UUID=0000fff2-0000-1000-8000-00805f9b34fb
BLE_NOTIFY_UUID=0000fff1-0000-1000-8000-00805f9b34fb

# Zamanlama ve Zaman Aşımı Ayarları (Saniye)
BLE_SCAN_TIMEOUT=6.0
BLE_RECONNECT_DELAY=2.0
BLE_COMMAND_TIMEOUT=0.6
BLE_POLL_INTERVAL=0.15
BLE_IDLE_POLL_INTERVAL=1.0
BLE_SLOW_PID_INTERVAL=5.0

# 2006 Toyota Corolla 1.4 D-4D (1ND-TV) Yakıt ve Motor Parametreleri
DIESEL_DENSITY=840.0
MIN_DIESEL_AFR=18.0
MAX_DIESEL_AFR=65.0
CRUISE_DEFAULT_AFR=32.0
